{
  "name": "dsh-laravel-skills",
  "version": "0.1.0",
  "description": "Version-aware Laravel engineering skills for DeepSeek Harness: stack detection, per-version guidance, SOLID design, and stack-specific playbooks.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./provider": "./lib/provider.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-bundle",
    "skills",
    "laravel",
    "php"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogidimitrov/dsh-laravel.git"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
